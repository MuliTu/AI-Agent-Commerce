# Choose exactly one configured model provider. With `disabled`, the UI shows
# a configuration-required state and the API returns a typed 503 response.
LLM_PROVIDER=disabled
# LLM_API_KEY=
# LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Local-only LiteLLM option (requires the approved loopback tunnel/service):
# LLM_PROVIDER=litellm
# LLM_API_KEY=
# LLM_MODEL=qwen3.5-9b
# LLM_BASE_URL=http://127.0.0.1:4001/v1
