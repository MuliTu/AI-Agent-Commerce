# The foundation runs offline without a provider credential.
# Required only when enabling the planned OpenAI integration.
AI_PROVIDER=disabled
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=

# Optional local-development provider through a loopback-only LiteLLM endpoint.
# This path does not replace final GPT-5.4-mini verification.
# AI_PROVIDER=litellm
# LITELLM_BASE_URL=http://127.0.0.1:4001/v1
# LITELLM_MODEL=qwen3.5-9b
# LITELLM_API_KEY=
