# Choose exactly one configured model provider. With `disabled`, the UI shows
# a configuration-required state and the API returns a typed 503 response.
LLM_PROVIDER=disabled
# LLM_API_KEY=
# LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Local-only LiteLLM option (requires the approved loopback tunnel/service):
# LLM_PROVIDER=litellm
# LLM_API_KEY=
# LLM_MODEL=qwen3.5-9b
# LLM_BASE_URL=http://127.0.0.1:4001/v1

# Optional local runtime settings:
# BAZAK_DATABASE_PATH=var/data/commerce.sqlite
# Development only: off (default), summary, or verbose. Production is always off.
# BAZAK_SERVER_DIAGNOSTICS=summary

# Optional live-evaluation output. Keep this ignored directory local because it
# may contain complete prompts and catalog evidence.
# BAZAK_EVAL_ARTIFACT_DIR=var/evaluations/live-ai/my-run
